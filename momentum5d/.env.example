# J-Quants API V2ダッシュボードで発行したAPIキー
JQUANTS_API_KEY=replace-with-your-api-key

# 通常は変更不要
JQUANTS_BASE_URL=https://api.jquants.com/v2
DATA_DIR=data
LOG_DIR=logs

# 投資対象市場（0111=プライム）。複数指定はカンマ区切り
UNIVERSE_MARKET_CODES=0111

# 契約プランの上限以下に設定（Free=5, Light=60, Standard=120, Premium=500）
JQUANTS_REQUESTS_PER_MINUTE=5
JQUANTS_CONNECT_TIMEOUT_SECONDS=10
JQUANTS_READ_TIMEOUT_SECONDS=30
JQUANTS_MAX_RETRIES=5
JQUANTS_BACKOFF_BASE_SECONDS=1

# 品質検査
ABNORMAL_RETURN_THRESHOLD=0.50
SPLIT_RATIO_TOLERANCE=0.25

# yfinance（個人研究・非公開利用）
YAHOO_RETENTION_DAYS=365
YAHOO_OVERLAP_DAYS=10
YAHOO_BATCH_SIZE=40
YAHOO_PAUSE_SECONDS=2
YAHOO_MAX_RETRIES=3
YAHOO_TIMEOUT_SECONDS=30
YAHOO_INTRADAY_MIN_COVERAGE=0.70
